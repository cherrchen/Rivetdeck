{
  "name": "@dsh-electron/dsh-electron-ui-desktop-plugins",
  "description": "Official Plugins page roster for Desktop-required packages",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "package.json"
  ]
}
