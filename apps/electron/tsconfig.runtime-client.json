{
  "extends": "../../tsconfig.base.client.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    "paths": {
      "@dsh-electron/dsh-electron-desktop-capabilities/client": [
        "./runtime/plugins/desktop-capabilities/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-api-remotes/client": [
        "../../packages/api/remotes/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-ui-plugin-manager/client": [
        "../../packages/client/ui-plugin-manager/src/client/index.ts"
      ],
      "@deepseek-ai/dsh-client-locale/client": [
        "../../packages/client/locale/src/client/index.ts"
      ]
    }
  },
  "include": [
    "runtime/plugins/*/src/client/**/*.ts",
    "runtime/plugins/*/src/client/**/*.tsx"
  ]
}
