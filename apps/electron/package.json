{
  "name": "@dsh-electron/dsh-electron",
  "productName": "DeepSeek Harness",
  "description": "Electron desktop shell for DeepSeek Harness",
  "version": "0.2.0-rc.2",
  "private": true,
  "homepage": "https://github.com/cherrchen/deepseek-harness-electron",
  "repository": {
    "type": "git",
    "url": "https://github.com/cherrchen/deepseek-harness-electron.git"
  },
  "type": "module",
  "main": "lib/main.js",
  "license": "MIT",
  "dshElectron": {
    "runtimePlugins": [],
    "ecosystemPlugins": [
      "@dsh-electron/dsh-plugin-git",
      "@dsh-electron/dsh-theme-studio"
    ]
  },
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:preload": "node ./scripts/build-preload.mjs",
    "build:runtime-plugins": "node ./scripts/build-runtime-plugins.mjs",
    "build:tray": "node ./scripts/build-tray-icons.mjs",
    "build:renderer": "vite build",
    "build": "pnpm run build:tray && pnpm run build:runtime-plugins && pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.preload.json && tsc -p tsconfig.renderer.json && tsc -p tsconfig.runtime-host.json && tsc -p tsconfig.runtime-client.json",
    "prepare:node": "node ./scripts/prepare-node-runtime.mjs",
    "prepare:python": "node ./scripts/prepare-python-runtime.mjs",
    "prepare:toolchains": "node ./scripts/toolchains/prepare-toolchains.mjs",
    "smoke:toolchains": "node ./scripts/smoke-toolchains.mjs",
    "prepare:network-runtime": "node ./scripts/prepare-network-runtime.mjs",
    "test:network-runtime": "cargo test --locked --manifest-path native/network-runtime/Cargo.toml && pnpm run prepare:network-runtime && vitest run --config vitest.network-runtime.config.ts",
    "package": "pnpm run prepare:core && pnpm run prepare:network-runtime && electron-builder --publish never",
    "start": "pnpm run build && pnpm run prepare:core && pnpm run prepare:network-runtime && env -u ELECTRON_RUN_AS_NODE electron .",
    "test": "pnpm run build:runtime-plugins && vitest run --root ../.. apps/electron/tests",
    "test:ownership": "vitest run --config vitest.ownership.config.ts",
    "prepare:core": "node ./scripts/toolchains/prepare-core.mjs"
  },
