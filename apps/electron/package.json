    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.8"
  },
  "build": {
    "appId": "ai.deepseek.harness.desktop",
    "asar": false,
    "extraMetadata": {
      "name": "deepseek-harness-desktop"
    },
    "artifactName": "DeepSeek-Harness-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "../../dist/electron"
    },
    "files": [
      "lib/**/*",
      "dist/renderer/**/*",
      "runtime/**/*",
      "build/icon.png",
      "build/icon-mac.png",
      "build/tray/*.png",
      "package.json",
      "toolchains.lock.json",
      "scripts/toolchains/common.mjs",
      "scripts/toolchains/manifest.mjs"
    ],
    "publish": {
      "provider": "github",
      "owner": "cherrchen",
      "repo": "deepseek-harness-electron",
      "releaseType": "release"
    },
    "electronUpdaterCompatibility": ">=2.16",
    "extraResources": [
      {
        "from": "build/LICENSE.lobe-icons",
        "to": "LICENSE.lobe-icons"
      },
      {
        "from": ".electron-build/network-runtime/current",
        "to": "network-runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/icon-mac.png",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis"
      ],
      "extraResources": [
        {
          "from": ".electron-build/core-runtime/current",
          "to": "core-runtime"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "useZip": true,
      "differentialPackage": false,
      "include": ".electron-build/nsis/include.nsh"
    },
    "linux": {
      "category": "Development",
      "executableName": "deepseek-harness",
      "icon": "build/icons",
      "maintainer": "cherrchen <cherrchen@users.noreply.github.com>",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "beforePack": "./scripts/prepare-windows-installer.mjs"
  }
}
